# Recommended LOCAL .env — MySQL is the default database.
# 1) Start MySQL on this PC
# 2) Create DB if needed:  CREATE DATABASE novel_app_db CHARACTER SET utf8mb4;
# 3) Set MYSQL_PASSWORD to your real root (or app) password
# 4) Copy this file to backend/.env

# Active local config — points at your real phpMyAdmin database: novel_app_db_v2
ENV=development
DEBUG=true
DB_TYPE=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

MYSQL_SSL_DISABLED=true
MYSQL_INIT_SQL=setup_railway.sql
MYSQL_FALLBACK_SQLITE=true

UPLOAD_DIR=./uploads
JWT_SECRET=dev-secret-key-change-in-production
ADMIN_USERNAME=admin_Supun
ADMIN_PASSWORD=Ux3@f=7x2
ADMIN_TOKEN_EXPIRES_HOURS=24
GOOGLE_CLIENT_ID=470949991659-avk11lvc5sv1ffietga62f8h591t7ijc.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=470949991659-avk11lvc5sv1ffietga62f8h591t7ijc.apps.googleusercontent.com,470949991659-kq78v41kdm7ut9ivie0ul634hgj8bgd7.apps.googleusercontent.com
MYSQL_DATABASE=novel_app_db_v2